datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  MANAGER
  MEMBER
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum FileCategory {
  SPECIFICATION
  ASSET
  CONTRACT
  REPORT
  REFERENCE
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String
  passwordHash String
  role         Role          @default(MEMBER)
  department   String?
  avatarUrl    String?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  
  projectsLed   Project[]     @relation("ProjectLead")
  tasksAssigned Task[]        @relation("TaskAssignee")
  tasksCreated  Task[]        @relation("TaskCreator")
  filesUploaded FileAsset[]   @relation("FileUploader")
  activityLogs  ActivityLog[]

  @@map("users")
}

model Project {
  id          String        @id @default(cuid())
  title       String
  code        String        @unique // e.g., "OPS-2026"
  description String        @db.Text
  status      ProjectStatus @default(PLANNING)
  startDate   DateTime?
  targetDate  DateTime?
  leadId      String
  lead        User          @relation("ProjectLead", fields: [leadId], references: [id], onDelete: Restrict)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  tasks       Task[]
  files       FileAsset[]

  @@index([status])
  @@index([leadId])
  @@map("projects")
}

model Task {
  id          String     @id @default(cuid())
  taskNumber  String     @unique // e.g., "TSK-1042"
  title       String
  description String?    @db.Text
  status      TaskStatus @default(TODO)
  priority    Priority   @default(MEDIUM)
  dueDate     DateTime?
  
  projectId   String
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  assigneeId  String?
  assignee    User?      @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  
  creatorId   String
  creator     User       @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  
  files       FileAsset[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([status])
  @@index([priority])
  @@index([projectId])
  @@index([assigneeId])
  @@map("tasks")
}

model FileAsset {
  id          String       @id @default(cuid())
  name        String
  fileUrl     String
  fileSizeKb  Int
  mimeType    String
  category    FileCategory @default(REFERENCE)
  
  projectId   String?
  project     Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  taskId      String?
  task        Task?        @relation(fields: [taskId], references: [id], onDelete: SetNull)
  
  uploaderId  String
  uploader    User         @relation("FileUploader", fields: [uploaderId], references: [id], onDelete: Restrict)
  
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([projectId])
  @@index([taskId])
  @@index([category])
  @@map("file_assets")
}

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action     String   // e.g., "TASK_STATUS_CHANGED", "FILE_UPLOADED", "PROJECT_CREATED"
  entityType String   // "Project", "Task", "FileAsset", "User"
  entityId   String
  details    Json?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([entityType, entityId])
  @@map("activity_logs")
}
